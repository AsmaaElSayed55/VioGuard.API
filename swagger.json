          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          },
          "confirmPassword": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "TextSummaryDto": {
        "type": "object",
        "properties": {
          "totalTexts": {
            "type": "integer",
            "format": "int32"
          },
          "violentIncidents": {
            "type": "integer",
            "format": "int32"
          },
          "againstViolenceAnalyses": {
            "type": "integer",
            "format": "int32"
          },
          "neutralTextAnalyses": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
