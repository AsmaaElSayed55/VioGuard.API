          "totalAgainstViolenceAnalyses": {
            "type": "integer",
            "format": "int32"
          },
          "totalNeutralTextAnalyses": {
            "type": "integer",
            "format": "int32"
          },
          "violencePercentage": {
            "type": "number",
            "format": "double"
