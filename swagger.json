          "domainName": {
            "type": "string",
            "nullable": true
          },
          "contentType": {
            "type": "string",
            "nullable": true
          },
          "relativeTime": {
            "type": "string",
            "nullable": true
          },
          "safetyStatus": {
            "type": "string",
            "nullable": true
          }
