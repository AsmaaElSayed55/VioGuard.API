        "additionalProperties": false
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "MonthlyReportDashboardDto": {
        "type": "object",
        "properties": {
          "totalAnalyses": {
            "type": "integer",
            "format": "int32"
          },
          "totalViolentIncidents": {
            "type": "integer",
            "format": "int32"
